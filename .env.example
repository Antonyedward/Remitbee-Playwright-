# Remitbee Playwright — Environment Variables
# Copy this file to .env and fill in your values

BASE_URL=https://www.cp.wisecapitals.com
CORE_API=https://api.remitbee.com

# Personal (PA) test account
PERSONAL_EMAIL=
USER_PASSWORD=

# TOTP secret for otplib (used to generate OTP codes)
ENTER_OTP=

# Business account
BUSINESS_EMAIL=

# Forgot-password test account
FORGET_PASSWORD_EMAIL=remittesttestlevels@gmail.com

# Edge-case accounts
BLOCKED_EMAIL=
INVALID_USERNAME=invalid@example.com
INVALID_PASSWORD=wrongpassword123
